# --- Server ---
PORT=3000
# Publicly reachable base URL of THIS server (Meta must be able to fetch image
# URLs from the public internet — localhost will not work). e.g. an ngrok URL
# in dev, or your real domain in production.
PUBLIC_BASE_URL=https://your-public-domain.example.com

# --- Anthropic (content generation) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Meta / Facebook Graph API ---
# Graph API version to target
GRAPH_API_VERSION=v21.0
# The Facebook Page ID for Sky Unlimited Travel
FB_PAGE_ID=your-facebook-page-id
# A long-lived Page Access Token with pages_manage_posts + pages_read_engagement
FB_PAGE_ACCESS_TOKEN=your-page-access-token

# --- Instagram (Business account linked to the Facebook Page above) ---
IG_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
# Instagram publishing uses the SAME Page access token as Facebook (Meta unifies
# auth through the linked Facebook Page), so FB_PAGE_ACCESS_TOKEN is reused.

# --- Scheduling ---
# Cron expression for the first (or only) daily post. Default: 11:00 AM
# server time — chosen as a reasonable overlap between Facebook's morning
# engagement peak and Instagram's late-morning/lunch peak.
POST_CRON="0 11 * * *"
# Optional second post at a different time each day — e.g. Instagram's
# evening peak (~7pm) while POST_CRON covers Facebook's morning peak. Each
# runs as a fully independent post with its own AI-generated content and its
# own post type (not a repeat of the first post). Leave blank to post once
# per day instead of twice.
POST_CRON_2="0 19 * * *"
TIMEZONE=America/New_York

# --- Branding (used in the AI content prompt) ---
BRAND_NAME="Sky Unlimited Travel"
BRAND_TAGLINE="Premium travel booking for flights, hotels, and vacation packages to the US, Canada, Europe, Caribbean, and Mexico"
BRAND_ACCENT_COLOR=#1a2947
